# Required - KikoBooks MCP API endpoint
KIKOBOOKS_BASE_URL=https://mcp.kikobooks.com

# Primary credential - org API key ("kiko_..."). Exchanged for a JWT; never sent on data calls.
KIKOBOOKS_API_KEY=your_api_key_here

# Or use direct token auth (alternative to API key)
# KIKOBOOKS_ACCESS_TOKEN=your_jwt_token
# KIKOBOOKS_REFRESH_TOKEN=your_refresh_token

# Optional - absolute, writable path to persist the rotated JWT + refresh token
# between runs. The API key is NEVER written here. When unset, tokens live in
# memory only and the server re-authenticates with the API key on each start.
# KIKOBOOKS_TOKEN_STORE_PATH=/absolute/path/to/.kikobooks-tokens.json

# Optional - suppress whole tool tiers at registration (read tools always load).
# KIKOBOOKS_DISABLE_WRITE=true    # suppress create_* (and post_/reverse_) tools
# KIKOBOOKS_DISABLE_UPDATE=true   # suppress update_* tools
# KIKOBOOKS_DISABLE_DELETE=true   # suppress delete_*/void_* tools
